<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:weightSum="1">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/pauseButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="15dp"
            android:layout_gravity="end|top"
            android:contentDescription="@string/pause"
            app:srcCompat="@drawable/button_pause"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:padding="7dp"
            tools:ignore="ImageContrastCheck"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="25dp">

            <TextView
                android:id="@+id/timerTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_black"
                android:text="@string/_02_00"
                android:textSize="25sp"
                android:letterSpacing="0.1"
                android:textColor="@color/pink"
                tools:ignore="TextContrastCheck"
                android:gravity="center" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progress="100"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:progressDrawable="@drawable/custom_progress_bar" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/recipeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:paddingTop="10dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:textSize="15sp"
        android:fontFamily="@font/nunito_black"
        android:textColor="@color/aqua"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="30dp"
        android:minHeight="40dp"
        android:lines="2"
    />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/normalLayout"
            layout="@layout/game_normal_mode"
            android:visibility="gone" />

        <include
            android:id="@+id/hardLayout"
            layout="@layout/game_hard_mode"
            android:visibility="gone" />

        <TextView
            android:id="@+id/recipeName"
            android:text="@string/menu_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center"
            android:background="@drawable/header_aqua"
            android:fontFamily="@font/nunito_black"
            android:gravity="center"
            android:paddingLeft="40dp"
            android:paddingTop="15dp"
            android:paddingRight="40dp"
            android:paddingBottom="15dp"
            android:textColor="@color/white"
            android:textSize="20sp"
            tools:ignore="TextContrastCheck" />

    </FrameLayout>

    <!-- ส่วนที่ใช้ในการแสดงคะแนน -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center|center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="15dp">

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_black"
            android:gravity="center_horizontal"
            android:text="@string/score"
            android:textColor="@color/brown"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/scoreTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_black"
            android:text="@string/_0"
            android:textColor="@color/camel"
            android:textSize="25sp"
            tools:ignore="TextContrastCheck" />
    </LinearLayout>

</LinearLayout>